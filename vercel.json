{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/files/upload",
      "destination": "/api/upload.js"
    },
    {
      "source": "/api/files/complete-upload",
      "destination": "/api/complete-upload.js"
    },
    {
      "source": "/api/blob-upload-token",
      "destination": "/api/blob-upload-token.js"
    },
    {
      "source": "/api/files/:path*",
      "destination": "/api/files.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
